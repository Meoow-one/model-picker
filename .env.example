# 可选：站点自己的 DeepSeek Key，作为用户未填 Key 时的兜底
# 不配置也能用——用户在 /chat 的「模型设置」里填自己的 Key 即可
DEEPSEEK_API_KEY=

# 使用站点 Key 时，单实例每日 token 上限（不含用户自带 Key）
LLM_DAILY_TOKEN_BUDGET=300000

# 可选：Supabase 账号（收藏 / 对比清单 / 对话历史）
# 不配置时登录页会显示配置指引，其余功能不受影响
# 建表与 RLS：在 Supabase SQL Editor 运行 supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=